{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TODOCompanion",
  "version": "0.1.68",
  "identifier": "com.rafael.todocompanion",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "TODOCompanion",
        "width": 1180,
        "height": 760,
        "minWidth": 820,
        "minHeight": 540,
        "resizable": true,
        "maximizable": true,
        "decorations": false,
        "transparent": false,
        "alwaysOnTop": false,
        "shadow": true,
        "center": true,
        "visible": true,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": [],
    "icon": [
      "../assets/icon.ico",
      "icons/icon.png"
    ]
  }
}
